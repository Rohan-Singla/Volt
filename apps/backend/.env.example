# API port — optional, defaults to 4000
PORT=4000

# Postgres. Keep this in sync with packages/db/.env (Prisma CLI reads that one).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/volt"

# JWT signing secret. Backend only — never expose this to the client or the
# Next.js proxy; apps/web/proxy.ts intentionally does not verify signatures.
JWT_SECRET="change-me"

# https://platform.deepseek.com
DEEPSEEK_API_KEY=""

# https://e2b.dev
E2B_API_KEY=""

# Cloudflare R2 (S3-compatible) — stores project source snapshots
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
